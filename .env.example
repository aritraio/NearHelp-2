# =============================================================================
# NearHelp AI — environment configuration
# Copy to .env and adjust. NEVER commit .env (it is gitignored).
# Values below target LOCAL development without Docker (localhost hosts).
# docker-compose overrides the hosts (db / redis) for the container services.
# =============================================================================

# --- Core -------------------------------------------------------------------
ENV=development                      # development | staging | demo
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR

# --- Database ---------------------------------------------------------------
# Async driver — used by the FastAPI app
DATABASE_URL=postgresql+asyncpg://nearhelp:nearhelp@localhost:5432/nearhelp
# Sync driver — used ONLY by Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg://nearhelp:nearhelp@localhost:5432/nearhelp

# --- Redis (cache / idempotency / rate limits / arq queue) ------------------
REDIS_URL=redis://localhost:6379/0

# --- AI ----------------------------------------------------------------------
GEMINI_API_KEY=                      # from https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash        # classify / severity / guidance generation

# --- Auth (Phase 1) -----------------------------------------------------------
JWT_SECRET=dev-secret-change-me       # generate 64 random chars for anything shared
RATE_LIMIT_PER_MIN=100                # authenticated requests per user per minute
AUTH_RATE_LIMIT_PER_MIN=30            # /api/auth/* attempts per IP per minute
SOS_DAILY_LIMIT=10                    # consumed by the SOS engine (Phase 2)

# --- Storage (Phase 1) ---------------------------------------------------------
CERTIFICATE_DIR=./data/certificates   # skill certificates (GCS signed URLs in Phase 9)

# --- Docker Compose only (Postgres container bootstrap) ----------------------
POSTGRES_USER=nearhelp
POSTGRES_PASSWORD=nearhelp
POSTGRES_DB=nearhelp

# --- Future phases (documented now; not yet read by code) --------------------
# FCM_SERVICE_ACCOUNT_FILE=./secrets/firebase-service-account.json  # Phase 2 — push
# SENTRY_DSN=                                                   # Phase 9 — error tracking
# INTERNAL_TICK_SECRET=change-me                                # Phase 2 — protects /internal/*
